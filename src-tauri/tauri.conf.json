{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Rove Stopwatch",
  "version": "0.1.3",
  "identifier": "com.stopwatch.app",
  "build": {
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rove Stopwatch",
        "width": 600,
        "height": 100,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
