{
  "name": "rove-stopwatch",
  "version": "0.1.2",
  "description": "Rove Stopwatch, a simple stopwatch application built with Tauri",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "vite build && tauri build",
